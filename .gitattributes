# === Spring Boot-specific line endings ===
/backend/mvnw text eol=lf
/backend/*.cmd text eol=crlf

# === Global Line Ending Rule ===
* text=auto eol=lf

# === Java / Spring Boot ===
*.java      text eol=lf
*.xml       text eol=lf
*.properties text eol=lf
*.yml       text eol=lf

# === SvelteKit / JS / TS / Vite ===
*.js        text eol=lf
*.ts        text eol=lf
*.svelte    text eol=lf
*.json      text eol=lf
*.html      text eol=lf
*.css       text eol=lf
*.scss      text eol=lf
*.env       text eol=lf
*.md        text eol=lf
*.cjs       text eol=lf
*.mjs       text eol=lf

# === Shell / Batch Scripts ===
*.sh        text eol=lf
*.cmd       text eol=crlf
*.bat       text eol=crlf

# === Lock Files ===
package-lock.json binary
bun.lockb         binary
yarn.lock         binary

# === Binary Assets ===
*.png      binary
*.jpg      binary
*.jpeg     binary
*.gif      binary
*.webp     binary
*.ico      binary
*.pdf      binary
*.ttf      binary
*.woff     binary
*.woff2    binary
*.eot      binary

# === Logs ===
*.log      text

